{
    "compilerOptions": {
        "target": "ES6",
        "module": "commonjs",
        "rootDir": "./",
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "baseUrl": "./",
        "paths": {
            "*": ["node_modules/*", "src/types/*", "types/*"]
        }
    },
    "include": ["src/**/*", "src/conf", "bin/*", "**/*.ts"],
    "exclude": [
        "node_modules"
    ]
}